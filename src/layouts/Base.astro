---
import '../styles/global.css';
import '../styles/updates.css';
import '../styles/commands.css';
import '../styles/mobile.css';
import '../styles/cyberpunk.css';
import '../styles/interactive.css';
import '../styles/night-city.css';

interface Props {
  title?: string;
  description?: string;
  locale?: 'zh-CN' | 'en';
  languageHref?: string;
  alternatePath?: string;
}
const props = Astro.props;
const locale = props.locale ?? 'zh-CN';
const isEnglish = locale === 'en';
const title = props.title ?? (isEnglish ? 'JYC Engineering Lab' : 'JYC 技术实验室');
const description = props.description ?? (isEnglish
  ? 'Engineering notes on Agent systems, Java, data platforms, frontend development, and reproducible technical work.'
  : 'JYC 技术博客：Agent 工程、Java 后端、数据工程、全栈开发和工程实践');
const current = Astro.url.pathname;
const canonical = new URL(current, Astro.site).toString();
let inferredAlternatePath: string | undefined;
if (isEnglish) {
  if (current === '/en/') inferredAlternatePath = '/';
  else if (current === '/en/blog/') inferredAlternatePath = '/blog/';
  else if (current === '/en/projects/') inferredAlternatePath = '/projects/';
} else {
  if (current === '/') inferredAlternatePath = '/en/';
  else if (current === '/blog/') inferredAlternatePath = '/en/blog/';
  else if (current === '/projects/') inferredAlternatePath = '/en/projects/';
}
const resolvedAlternatePath = props.alternatePath ?? inferredAlternatePath;
const alternateUrl = resolvedAlternatePath ? new URL(resolvedAlternatePath, Astro.site).toString() : undefined;
const defaultLanguageHref = isEnglish ? '/' : current.startsWith('/blog/') ? '/en/blog/' : current.startsWith('/projects/') ? '/en/projects/' : '/en/';
const languageHref = props.languageHref ?? resolvedAlternatePath ?? defaultLanguageHref;
const links = isEnglish
  ? [
      { href: '/en/', label: 'Home' },
      { href: '/en/blog/', label: 'Articles' },
      { href: '/en/projects/', label: 'Projects' }
    ]
  : [
      { href: '/', label: '首页' },
      { href: '/blog/', label: '技术文章' },
      { href: '/projects/', label: '项目作品' },
      { href: '/learning/', label: '学习路线' },
      { href: '/commands/', label: '命令手册' },
      { href: '/updates/', label: '技术动态' },
      { href: '/knowledge/', label: '知识库' }
    ];
const rootHref = isEnglish ? '/en/' : '/';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b19" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={isEnglish ? 'en_US' : 'zh_CN'} />
    <link rel="canonical" href={canonical} />
    {alternateUrl && <>
      <link rel="alternate" hreflang={isEnglish ? 'en' : 'zh-CN'} href={canonical} />
      <link rel="alternate" hreflang={isEnglish ? 'zh-CN' : 'en'} href={alternateUrl} />
      <link rel="alternate" hreflang="x-default" href={isEnglish ? alternateUrl : canonical} />
    </>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!isEnglish && <link rel="alternate" type="application/rss+xml" title="JYC 技术博客 RSS" href="/rss.xml" />}
    <title>{isEnglish ? (title === 'JYC Engineering Lab' ? title : `${title} | JYC Engineering Lab`) : (title === 'JYC 技术实验室' ? title : `${title} · JYC 技术实验室`)}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{isEnglish ? 'Skip to content' : '跳到正文'}</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="header-inner container">
          <a class="brand" href={isEnglish ? '/en/' : '/'} aria-label={isEnglish ? 'JYC Engineering Lab home' : 'JYC 技术实验室首页'}>
            <span class="brand-mark" aria-hidden="true">J<span class="brand-dot">.</span></span>
            <span class="brand-copy"><strong>JYC</strong><small>{isEnglish ? 'ENGINEERING LAB' : '技术实验室'}</small></span>
          </a>
          <nav id="primary-navigation" class="site-nav" aria-label={isEnglish ? 'Primary navigation' : '主导航'}>
            {links.map((link) => (
              <a href={link.href} class:list={['nav-link', { active: link.href === rootHref ? current === rootHref : current.startsWith(link.href) }]} aria-current={(link.href === rootHref ? current === rootHref : current.startsWith(link.href)) ? 'page' : undefined}>{link.label}</a>
            ))}
          </nav>
          <div class="header-actions">
            {!isEnglish && <a class="header-search" href="/search/" aria-label="搜索文章"><span aria-hidden="true">⌕</span> <span>搜索</span><kbd>/</kbd></a>}
            <a class="language-switch" href={languageHref} aria-label={isEnglish ? 'Switch to Chinese' : '切换到英文站'}>{isEnglish ? 'Chinese' : 'English'}</a>
            <button class="mobile-menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false" aria-label={isEnglish ? 'Open navigation menu' : '打开导航菜单'}>
              <svg class="menu-bars" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
              <svg class="menu-x" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
            </button>
          </div>
        </div>
      </header>

      <main id="content"><slot /></main>

      <footer class="site-footer">
        <div class="container footer-inner">
          {isEnglish ? <>
            <div>
              <strong>JYC Engineering Lab</strong>
              <p>Engineering decisions explained. Technical work backed by evidence.</p>
            </div>
            <div class="footer-links">
              <a href="/en/blog/">Articles</a>
              <a href="/en/projects/">Projects</a>
              <a href="https://github.com/jyc-work" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            </div>
          </> : <>
            <div>
              <strong>JYC 技术实验室</strong>
              <p>记录可解释的工程决策，分享可验证的技术成果。</p>
            </div>
            <div class="footer-links">
              <a href="https://github.com/jyc-work" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              <a href="/updates/">技术动态</a>
              <a href="/commands/">命令手册</a>
              <a href="/knowledge/agent-patterns/">来源与引用</a>
            </div>
          </>}
          <span class="copyright">© {new Date().getFullYear()} JYC</span>
        </div>
      </footer>
    </div>
    <button class="back-to-top" type="button" aria-label={isEnglish ? 'Back to top' : '返回顶部'} title={isEnglish ? 'Back to top' : '返回顶部'} hidden>↑</button>
    <script>
      import '../scripts/cyberpunk';
      const englishUI = document.documentElement.lang === 'en';
      const menuButton = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
      const menu = document.querySelector<HTMLElement>('#primary-navigation');
      const mobileViewport = window.matchMedia('(max-width: 780px)');
      const closeMenu = (restoreFocus = false) => {
        if (!menuButton || !menu) return;
        const wasOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', 'false');
        menuButton.setAttribute('aria-label', englishUI ? 'Open navigation menu' : '打开导航菜单');
        menu.classList.remove('is-open');
        if (restoreFocus && wasOpen) menuButton.focus();
      };
      menuButton?.addEventListener('click', () => {
        const willOpen = menuButton.getAttribute('aria-expanded') !== 'true';
        if (!willOpen) { closeMenu(); return; }
        menuButton.setAttribute('aria-expanded', 'true');
        menuButton.setAttribute('aria-label', englishUI ? 'Close navigation menu' : '关闭导航菜单');
        menu?.classList.add('is-open');
      });
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeMenu()));
      document.addEventListener('pointerdown', (event) => {
        if (menuButton?.getAttribute('aria-expanded') !== 'true') return;
        if (!(event.target instanceof Node) || !event.target.parentElement?.closest('.site-header')) closeMenu();
      });
      mobileViewport.addEventListener('change', () => closeMenu());

      document.querySelectorAll<HTMLPreElement>('.prose pre').forEach(pre => {
        const code = pre.querySelector('code');
        if (!code || pre.querySelector('.article-copy, .command-copy')) return;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'article-copy';
        const copyLabel = englishUI ? 'Copy code' : '复制代码';
        button.textContent = copyLabel;
        button.setAttribute('aria-label', copyLabel);
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(code.textContent ?? '');
            button.textContent = englishUI ? 'Copied' : '已复制';
          } catch {
            button.textContent = englishUI ? 'Copy failed; select manually' : '复制失败，请手动选择';
          }
          window.setTimeout(() => { button.textContent = copyLabel; }, 1800);
        });
        pre.appendChild(button);
      });

      const backToTop = document.querySelector<HTMLButtonElement>('.back-to-top');
      const updateBackToTop = () => {
        if (backToTop) backToTop.hidden = window.scrollY < 560;
      };
      window.addEventListener('scroll', updateBackToTop, {passive: true});
      updateBackToTop();
      backToTop?.addEventListener('click', () => window.scrollTo({
        top: 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'
      }));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
          event.preventDefault();
          closeMenu(true);
        }
        const target = event.target;
        if (event.key === '/' && !(target instanceof HTMLInputElement) && !(target instanceof HTMLTextAreaElement) && !event.metaKey && !event.ctrlKey) {
          event.preventDefault();
          window.location.href = englishUI ? '/en/blog/' : '/search/';
        }
      });
    </script>
  </body>
</html>
