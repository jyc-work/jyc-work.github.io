---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const featured = projects.slice(0, 3);
---
<Base>
  <HomeHero lang="zh-CN" />

  <section class="manifest container">
    <span>研究原则</span>
    <p>不是堆砌名词的技术博客。<strong>问题 → 假设 → 实现 → 验证 → 边界</strong>，才是值得保留的工程记录。</p>
  </section>

  <section class="section container">
    <div class="section-heading"><div><div class="section-kicker">项目实践</div><h2>精选项目<span class="accent">.</span></h2><p>基于真实工程，展示设计、诊断方法与验证边界。</p></div><a class="text-link" href="/projects/">全部项目 <span>↗</span></a></div>
    <div class="project-grid">
      {featured.map((project, index) => (
        <a class="project-card" href={`/projects/${project.slug}/`}>
          <div class="card-head"><span class="card-index">0{index + 1}</span><span class="status-pill">{project.status}</span></div>
          <div class="project-glyph" aria-hidden="true">{index === 0 ? '⌘' : index === 1 ? '⌁' : '⟡'}</div>
          <div class="project-category">{project.category}</div>
          <h3>{project.name}</h3>
          <p>{project.summary}</p>
          <div class="stack-list">{project.stack.slice(0, 3).map((tag) => <span>{tag}</span>)}</div>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <div class="section-heading"><div><div class="section-kicker">技术文章</div><h2>工程记录<span class="accent">.</span></h2><p>从真实问题出发的技术记录。</p></div><a class="text-link" href="/blog/">全部文章 <span>↗</span></a></div>
      <div class="article-list">
        {posts.map((post, index) => (
          <a class="article-row" href={`/blog/${post.id}/`}>
            <span class="article-index">0{index + 1}</span><div class="article-row-main"><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div></div><span class="article-date">{post.data.date.toISOString().slice(0, 10)}</span><span class="article-go">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="learning-teaser container">
    <div>
      <div class="section-kicker">命令速查</div>
      <h2>工程命令手册<span class="accent">.</span></h2>
      <p>14 个工作命令专题：Linux、容器、K8s、Hadoop、Kafka、Flink，以及 SQL、MySQL、ClickHouse、PostgreSQL、Redis、GaussDB 等数据库速查。</p>
      <p>命令按用途、部署环境与风险归档；不要把示例当成可直接执行的生产脚本。</p>
    </div>
    <a href="/commands/" class="btn secondary">打开命令手册 <span>→</span></a>
  </section>
  <section class="learning-teaser container">
    <div><div class="section-kicker">学习路线</div><h2>以实践推进学习<span class="accent">.</span></h2><p>五条工程学习路线、八个精选 GitHub 项目。每个阶段都以源码理解和可检查的实操作为验收。</p><p><a class="text-link" href="/updates/">查看自动跟踪的技术动态 ↗</a></p></div>
    <a href="/learning/" class="btn secondary">查看学习路线 <span>→</span></a>
  </section>

  <section class="knowledge-banner container">
    <div><div class="section-kicker">知识库</div><h2>整理技术知识<br /><span class="gradient-text">沉淀工程经验</span></h2><p>概念、源码位置、实验与参考资料一处归档。优先链接原始来源，保留原创理解和验证状态。</p><a href="/knowledge/" class="btn secondary">进入知识库 <span>→</span></a></div>
    <div class="knowledge-wire" aria-hidden="true"><span>信息感知</span><span>推理分析</span><span>工具调用</span><span>运行框架</span><span>权限治理</span><span>测试评估</span></div>
  </section>
</Base>
