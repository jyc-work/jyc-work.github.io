---
import Base from '../../../layouts/Base.astro';
import ReadingToc from '../../../components/ReadingToc.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
export async function getStaticPaths() {
  const entries=await getCollection('enBlog',({data})=>!data.draft);
  return entries.map(entry=>({params:{slug:entry.id},props:{entry}}));
}
const {entry}=Astro.props as {entry:CollectionEntry<'enBlog'>};
const {Content,headings}=await render(entry);
---
<Base lang="en" title={entry.data.title} description={entry.data.description}>
  <div class="container reader-grid">
    <article class="reading-article">
      <div class="breadcrumbs"><a href="/en/">Home</a><span>/</span><a href="/en/articles/">Articles</a><span>/</span><span>Case study</span></div>
      <div class="page-eyebrow">Published {entry.data.date.toISOString().slice(0,10)}</div>
      <h1>{entry.data.title}</h1><p class="article-intro">{entry.data.description}</p>
      <div class="tags article-tags">{entry.data.tags.map(tag=><span>{tag}</span>)}</div>
      <p class="source-alert">Verification: <strong>public source review only</strong>, not independent runtime reproduction.
        <a href={`${entry.data.repository}/commit/${entry.data.revision}`} target="_blank" rel="noopener noreferrer">Pinned commit {entry.data.revision.slice(0,10)} ↗</a>
      </p>
      <ReadingToc lang="en" headings={headings}/>
      <div class="prose"><Content /></div>
      <div class="article-end">
        <a href="/en/articles/">← All articles</a>
        <a href={`/blog/${entry.data.zhSlug}/`} hreflang="zh-CN">Read Chinese edition →</a>
      </div>
    </article>
    <aside class="toc" aria-label="Table of contents">
      <div class="toc-title">On this page</div>
      {headings.filter(h=>h.depth===2||h.depth===3).map(h=><a class:list={['toc-item',{'toc-nested':h.depth===3}]} href={`#${h.slug}`}>{h.text}</a>)}
    </aside>
  </div>
</Base>
