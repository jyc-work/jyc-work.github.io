---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('enBlog', ({data})=>!data.draft))
  .sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
---
<Base lang="en" title="JYC Engineering Lab" description="Source-backed software engineering, reliable delivery pipelines, and tested frontend systems.">
  <section class="hero container en-hero">
    <div class="hero-copy">
      <div class="page-eyebrow">Software engineering portfolio</div>
      <h1>Engineering<br /><span class="gradient-text">with evidence.</span></h1>
      <p class="hero-zh">Architecture. Implementation. Verification. Trade-offs.</p>
      <p class="hero-desc">I document software systems through inspectable source code, reproducible procedures, and explicit limitations. Current public work focuses on development tooling, web engineering, and reliability.</p>
      <div class="hero-actions">
        <a class="btn primary" href="/en/projects/">Explore projects <span aria-hidden="true">↗</span></a>
        <a class="btn secondary" href="/en/articles/">Read case studies <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-visual" aria-label="Original neon city illustration and an example engineering workflow">
      <div class="night-city-art" aria-hidden="true"></div>
      <div class="orb orb-a"></div><div class="orb orb-b"></div>
      <div class="terminal-card en-terminal">
        <div class="terminal-top"><span class="terminal-dots"><i></i><i></i><i></i></span><span>Reviewable delivery workflow</span></div>
        <div class="terminal-body" aria-hidden="true">
          <div><span class="line-number">01</span> Source review</div>
          <div><span class="line-number">02</span> Type check + build</div>
          <div><span class="line-number">03</span> Browser regression</div>
          <div><span class="line-number">04</span> Merge approval</div>
          <div><span class="line-number">05</span> Deployment verification</div>
        </div>
      </div>
    </div>
  </section>
  <section class="manifest container"><span>Principle</span><p>Every public engineering claim should have a source, a way to verify it, and a clearly stated boundary.</p></section>
  <section class="section container">
    <div class="section-heading"><div><div class="section-kicker">Project</div><h2>Inspectable engineering work<span class="accent">.</span></h2><p>Public code first. Unpublished or third-party code is not represented as verified original work.</p></div><a class="text-link" href="/en/projects/">Project details ↗</a></div>
    <a class="project-card en-featured-project" href="/en/projects/jyc-engineering-lab/">
      <div class="card-head"><span class="card-index">Public repository</span><span class="status-pill">Source available</span></div>
      <div class="project-glyph" aria-hidden="true">⌘</div>
      <div class="project-category">Astro · TypeScript · GitHub Actions · Playwright</div>
      <h3>JYC Engineering Lab</h3>
      <p>A static technical publication system with pull-request build gates, responsive browser tests, and evidence-aware engineering case studies.</p>
      <div class="stack-list"><span>CI/CD</span><span>Browser testing</span><span>Documentation</span></div>
      <span class="card-arrow" aria-hidden="true">↗</span>
    </a>
  </section>
  <section class="section section-muted"><div class="container">
    <div class="section-heading"><div><div class="section-kicker">Engineering writing</div><h2>Case studies<span class="accent">.</span></h2><p>English editions are curated individually, not generated for every Chinese note.</p></div><a class="text-link" href="/en/articles/">All articles ↗</a></div>
    <div class="article-list">{posts.map((post,i)=><a class="article-row" href={`/en/articles/${post.id}/`}>
      <span class="article-index">{String(i+1).padStart(2,'0')}</span>
      <div class="article-row-main"><h3>{post.data.title}</h3><p>{post.data.description}</p><div class="tags">{post.data.tags.map(tag=><span>{tag}</span>)}</div></div>
      <span class="article-date">{post.data.date.toISOString().slice(0,10)}</span><span class="article-go">↗</span>
    </a>)}</div>
  </div></section>
</Base>
