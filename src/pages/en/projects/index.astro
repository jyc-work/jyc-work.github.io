---
import Base from '../../../layouts/Base.astro';
---
<Base lang="en" title="Engineering projects" description="Public software engineering projects with explicit source and verification status.">
  <div class="container listing-page">
    <h1>Engineering projects<span class="accent">.</span></h1>
    <p class="page-lead">This portfolio highlights work with inspectable public source. Private projects and third-party source studies are not presented as independently verifiable original products.</p>
    <div class="project-grid project-listing">
      <a class="project-card" href="/en/projects/jyc-engineering-lab/">
        <div class="card-head"><span class="card-index">01 / Original work</span><span class="status-pill">Public source</span></div>
        <div class="project-glyph" aria-hidden="true">⌘</div>
        <div class="project-category">Static publishing · Quality engineering</div>
        <h3>JYC Engineering Lab</h3>
        <p>A technical publishing platform using Astro, structured content, GitHub Actions and Chromium regression tests. The architecture and test definitions can be inspected publicly.</p>
        <div class="stack-list"><span>Astro</span><span>TypeScript</span><span>Playwright</span></div>
        <span class="card-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</Base>
