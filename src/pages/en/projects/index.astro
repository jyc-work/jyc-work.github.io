---
import Base from '../../../layouts/Base.astro';
const projects = [
  {
    name: 'JYC Engineering Lab',
    category: 'Static publishing · Quality engineering',
    summary: 'An Astro-based public engineering site with a publishing quality gate, GitHub Pages automation, and browser-level regression tests.',
    status: 'Public source',
    stack: ['Astro', 'GitHub Actions', 'Playwright'],
    href: '/en/blog/astro-pages-engineering-case/',
    linkLabel: 'Read the engineering case'
  },
  {
    name: 'DataOps Copilot V1',
    category: 'Agent systems · Data engineering',
    summary: 'An internal validation project exploring evidence collection, rule-based diagnosis, model-assisted explanations, and recovery verification for data-platform incidents.',
    status: 'Source not public',
    stack: ['Java', 'Kafka', 'Flink', 'ClickHouse'],
    href: '',
    linkLabel: ''
  },
  {
    name: 'Agent Harness Source Study',
    category: 'Open-source study',
    summary: 'A source-reading project mapping Agent loops, tool execution, state management, and reliability patterns to real code. This is a study of an upstream project, not a claim of original authorship.',
    status: 'Public research repository',
    stack: ['Agent Runtime', 'TypeScript', 'Testing'],
    href: 'https://github.com/jyc-work/deepseek-harness',
    linkLabel: 'View the research repository'
  }
];
---
<Base locale="en" title="Projects" description="Engineering projects with clear source visibility, evidence status, and known limitations." alternatePath="/projects/">
  <div class="container listing-page">
    <h1>Projects<span class="accent">.</span></h1>
    <p class="page-lead">The portfolio distinguishes public source, internal validation, and upstream code study. A project is not described as independently reproducible unless the supporting artifacts are available.</p>
    <div class="project-grid project-listing">
      {projects.map((project, i) => (
        <article class="project-card">
          <div class="card-head"><span class="card-index">{String(i+1).padStart(2,'0')}</span><span class="status-pill">{project.status}</span></div>
          <div class="project-glyph" aria-hidden="true">{['⌘','⌁','⧉'][i]}</div>
          <div class="project-category">{project.category}</div><h3>{project.name}</h3><p>{project.summary}</p>
          <div class="stack-list">{project.stack.map(tag=><span>{tag}</span>)}</div>
          {project.href && <a class="text-link" href={project.href} target={project.href.startsWith('http') ? '_blank' : undefined} rel={project.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{project.linkLabel} ↗</a>}
        </article>
      ))}
    </div>
  </div>
</Base>
