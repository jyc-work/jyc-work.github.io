---
import Base from '../../layouts/Base.astro';
import { learningPaths, featuredRepositories } from '../../data/learning';
import { getCollection } from 'astro:content';
const lessons=await getCollection('tutorials',({data})=>!data.draft);
const stageCount=learningPaths.reduce((sum,path)=>sum+path.stages.length,0);
---
<Base title="技术学习路线" description="六个领域的原创教程、工程学习路线与八个精选开源项目">
  <div class="container listing-page">
    
    <h1>技术学习路线<span class="accent">.</span></h1>
    <p class="page-lead">从可运行的最小实现开始，逐步补齐原理、故障处理、测试和可复现的成果。覆盖 6 个领域和原创实操教程，GitHub 精选项目保持 8 个。</p>

    <section class="learning-progress-panel" aria-label="个人学习进度面板">
      <div class="progress-header"><strong>个人学习进度</strong><span id="learning-progress-total" class="progress-total-label">0 / {stageCount}</span></div>
      <progress id="learning-total-bar" class="learning-meter" value="0" max={stageCount} aria-label="已自评完成的学习阶段"></progress>
      <p class="progress-subtitle">在各路线中完成动手任务并自行核对验收标准后，勾选对应阶段。本进度是个人自评，不代表本站已验证代码或考试成绩。</p>
      <div class="learning-progress-actions">
        <button id="learning-export" class="progress-action" type="button">↓ 导出进度 JSON</button>
        <label class="progress-import-label">↑ 导入进度 JSON<input id="learning-import" type="file" accept=".json,application/json" aria-label="导入进度 JSON" /></label>
      </div>
      <p class="progress-note">仅存储在当前浏览器（localStorage），不上传至服务器，也不会在设备间自动同步。清除网站数据会丢失记录，可手动导出备份。</p>
      <p id="learning-storage-status" class="progress-note" role="status" aria-live="polite"></p>
    </section>

    <div class="learning-tutorial-intro"><div><strong>新上线：可阅读、可练习的正文教程</strong><p>不仅有路线表：包含原理讲解、可运行的代码示例、实验设计、错误分析、验收题。当前收录 {lessons.length} 篇独立原创教程。</p></div><a href="/tutorials/" class="btn primary">阅读完整教程 →</a></div>

    <div class="roadmap-grid">
      {learningPaths.map((path,i)=><a href={`/learning/${path.slug}/`} class="roadmap-card" data-progress-slug={path.slug} data-progress-total={path.stages.length}>
        <div class="roadmap-top"><span>路线 {String(i+1).padStart(2,'0')}</span><span>↗</span></div>
        <div class="roadmap-subtitle">{path.subtitle}</div><h2>{path.title}</h2><p>{path.summary}</p>
        <div class="roadmap-footer"><span>{path.stages.length} 个阶段</span><span>{path.repositories.length} 个 GitHub 项目 · {lessons.filter(l=>l.data.track===path.slug).length} 篇教程</span></div>
        <div class="roadmap-progress"><div class="roadmap-progress-label"><span>已完成</span><span data-progress-label>0 / {path.stages.length} 阶段</span></div><progress class="learning-meter" max={path.stages.length} value="0" aria-label={`${path.title} 个人学习进度`}></progress></div>
      </a>)}
    </div>

    <div class="section-heading resources-title"><div><h2>开源学习项目<span class="accent">.</span></h2><p>仅收录可确认的真实仓库，按学习价值而不是 Star 排名。</p></div></div>
    <div class="resource-grid">{featuredRepositories.map((repo,i)=><a href={repo.url} class="resource-card" target="_blank" rel="noopener noreferrer">
      <div class="resource-top"><span>{String(i+1).padStart(2,'0')}</span><span class="resource-link">↗</span></div>
      <h3>{repo.name}</h3><div class="resource-domain">{repo.domain} · {repo.level}</div>
      <p>{repo.purpose}</p><div class="resource-task"><strong>实操：</strong>{repo.task}</div>
    </a>)}</div>
    <p class="resource-disclaimer">这些链接是独立学习资源，既不代表本网站参与维护，也不意味着已复现其全部示例。使用时请阅读各仓库 README 与 License，并记录你所研究的 Commit。</p>
  </div>
  <script>import '../../scripts/learning-progress';</script>
</Base>
