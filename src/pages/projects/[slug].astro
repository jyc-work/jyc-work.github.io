---
import Base from '../../layouts/Base.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths(){
  return projects.map((project)=>({params:{slug:project.slug},props:{project}}));
}
const {project}=Astro.props as {project: Project};
---
<Base title={project.name} description={project.summary}>
  <div class="container project-detail">
    <div class="breadcrumbs"><a href="/">首页</a><span>/</span><a href="/projects/">项目</a><span>/</span><span>案例</span></div>
    <div class="page-eyebrow">{project.kind === 'study' ? '开源研究' : '原创项目'}</div>
    <h1>{project.name}<span class="accent">.</span></h1><p class="page-lead">{project.summary}</p>
    <div class="detail-labels"><span>{project.status}</span><span>{project.visibility}</span><span>{project.category}</span></div>
    <div class="detail-grid">
      <article>
        <section class="detail-section"><h2>01 <span>/</span> 问题定义</h2><p>{project.challenge}</p></section>
        <section class="detail-section"><h2>02 <span>/</span> 设计与方法</h2><p>{project.approach}</p></section>
        <section class="detail-section"><h2>03 <span>/</span> 当前证据</h2><ul>{project.evidence.map((e)=><li>{e}</li>)}</ul></section>
        <section class="detail-section"><h2>04 <span>/</span> 限制与下一步</h2><ul>{project.limitations.map((e)=><li>{e}</li>)}</ul></section>
        <div class="detail-note">验证说明：本页提供项目概述和证据披露状态。未附有公开执行日志与独立复现环境的内容，不应解读为已经得到第三方验证。</div>
      </article>
      <aside class="detail-side"><div class="toc-title">技术栈</div><div class="tags">{project.stack.map((t)=><span>{t}</span>)}</div><div class="toc-title" style="margin-top:32px">源代码</div>{project.source ? <a class="text-link" href={project.source} target="_blank" rel="noopener noreferrer">阅读公开研究仓库 ↗</a> : <p class="side-muted">暂无可公开源码；后续会补充脱敏、可复现的材料。</p>}<a class="back-link" href="/projects/">← 全部项目</a></aside>
    </div>
  </div>
</Base>
