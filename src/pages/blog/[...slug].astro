---
import Base from '../../layouts/Base.astro';
import ReadingToc from '../../components/ReadingToc.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as { entry: CollectionEntry<'blog'> };
const { Content, headings } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <div class="container reader-grid">
    <article class="reading-article">
      <div class="breadcrumbs"><a href="/">首页</a><span>/</span><a href="/blog/">文章</a><span>/</span><span>阅读</span></div>
      <div class="page-eyebrow">FIELD NOTE / {entry.data.date.toISOString().slice(0,10)}</div>
      <h1>{entry.data.title}</h1><p class="article-intro">{entry.data.description}</p>
      <div class="tags article-tags">{entry.data.tags.map((tag) => <span>{tag}</span>)}</div>
      {entry.data.repository && entry.data.revision && <p class="source-alert">证据等级：{entry.data.verification === "source-reviewed" ? "公开源码核查（非独立运行验证）" : entry.data.verification === "runtime-tested" ? "已执行测试（需查阅运行产物）" : "外部复现记录"} · <a href={`${entry.data.repository}/commit/${entry.data.revision}`} target="_blank" rel="noopener noreferrer">固定版本 {entry.data.revision.slice(0, 10)} ↗</a></p>}
      <ReadingToc headings={headings} />
      <div class="prose"><Content /></div>
      <div class="article-end"><a href="/blog/">← 返回文章列表</a><a href="https://github.com/jyc-work/jyc-work.github.io" target="_blank" rel="noopener noreferrer">发现错误？查看仓库 ↗</a></div>
    </article>
    <aside class="toc" aria-label="本页目录"><div class="toc-title">ON THIS PAGE</div>{headings.filter((h)=>h.depth===2 || h.depth===3).map((h)=><a class:list={['toc-item',{'toc-nested':h.depth===3}]} href={`#${h.slug}`}>{h.text}</a>)}</aside>
  </div>
</Base>
